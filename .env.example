# Local mock vendor-risk service
VENDOR_RISK_BASE_URL=http://127.0.0.1:8001

# LLM provider: groq | offline   (offline = deterministic rules only, no model calls)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
# Any Groq chat model with tool calling, e.g. openai/gpt-oss-120b or openai/gpt-oss-20b
MODEL_NAME=openai/gpt-oss-120b
LLM_TEMPERATURE=0
# Optional tuning
# LLM_REASONING_EFFORT=medium    # low | medium | high (gpt-oss models)
# LLM_MAX_RATE_RETRIES=6         # how many 429 retry-after waits before degrading to deterministic mode
# EVAL_PAUSE_SECONDS=8           # pause between eval runs (free tier: 8,000 tokens/minute)
